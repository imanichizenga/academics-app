# Django
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=
# Database and queue
POSTGRES_DB=darasa
POSTGRES_USER=darasa
POSTGRES_PASSWORD=darasa
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
# Public origins. PUBLIC_API_URL is what Snippe calls for webhooks: it must be a public HTTPS URL in production.
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
# Set true behind HTTPS
COOKIE_SECURE=false
# Your own proxies in front of Django, counting Next.js when traffic goes through it. Rate limits depend on this.
NUM_PROXIES=1
